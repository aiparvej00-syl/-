<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sylhet Social</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background: #eef3ef; color: #162219; padding-bottom: 80px; }
    .topbar {
      position: sticky; top: 0; z-index: 20;
      background: #0f5132; color: #ffffff;
      padding: 12px 14px; display: flex; align-items: center; justify-content: space-between; gap: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }
    .brand { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 18px; }
    .role-badge {
      background: #198754; color: #fff; border: 1px solid #86efac;
      padding: 6px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; cursor: pointer;
    }
    .subnav {
      display: flex; gap: 6px; padding: 10px 12px; background: #ffffff;
      border-bottom: 1px solid #d4dfd7; overflow-x: auto;
    }
    .nav-btn {
      border: 1px solid #c6d5ca; background: #f4f8f5; color: #162219;
      padding: 9px 13px; border-radius: 10px; font-size: 13px; font-weight: 700;
      cursor: pointer; white-space: nowrap;
    }
    .nav-btn.active { background: #0f5132; color: #ffffff; border-color: #0f5132; }
    .container { max-width: 680px; margin: 0 auto; padding: 12px; }
    .card {
      background: #ffffff; border: 1px solid #d7e2da; border-radius: 14px;
      padding: 14px; margin-bottom: 12px; box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }
    .card-title { font-size: 16px; font-weight: 800; margin-bottom: 10px; color: #0f5132; }
    textarea, input, select {
      width: 100%; border: 1px solid #b9cbbd; border-radius: 10px;
      padding: 10px 12px; font-size: 14px; margin-bottom: 10px; background: #fbfdfb; color: #162219;
    }
    .btn {
      background: #0f5132; color: #ffffff; border: none; border-radius: 10px;
      padding: 10px 14px; font-size: 14px; font-weight: 700; cursor: pointer;
    }
    .btn.secondary { background: #e9f2ec; color: #0f5132; border: 1px solid #9ec2aa; }
    .btn.danger { background: #b42318; color: #ffffff; }
    .btn.small { padding: 6px 10px; font-size: 12px; border-radius: 8px; }
    .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .tag {
      display: inline-block; background: #e6f4ea; color: #0f5132;
      padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; margin-bottom: 8px;
    }
    .ad-tag {
      display: inline-block; background: #fef3c7; color: #92400e;
      padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 800; margin-bottom: 8px;
    }
    .post-meta { font-size: 12px; color: #526357; margin-bottom: 8px; }
    .post-text { font-size: 15px; line-height: 1.5; margin-bottom: 10px; }
    .comment-box { background: #f3f7f4; padding: 8px 10px; border-radius: 8px; margin-top: 6px; font-size: 13px; }
    .msg-bubble {
      background: #e6f4ea; padding: 10px 12px; border-radius: 12px; margin-bottom: 8px; font-size: 14px;
    }
    .msg-bubble.me { background: #0f5132; color: #ffffff; margin-left: 24px; }
    .payment-box {
      background: #f0fdf4; border: 1px solid #86efac; border-radius: 12px;
      padding: 12px; margin-bottom: 10px;
    }
    .hidden { display: none; }
  </style>
</head>
<body>

  <header class="topbar">
    <div class="brand">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
        <path d="M20 4C11 4 5 9 5 17C5 18.5 5.4 19.5 6 20C9 19.5 13 17 16 13.5C18.5 10.5 20 7.5 20 4Z" fill="#4ade80"/>
        <path d="M6 19C10 15 14 11 19 6" stroke="#dcfce7" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
      <span>Sylhet Social</span>
    </div>
    <button class="role-badge" id="roleToggleBtn" onclick="cycleRole()">মোড: সুপার অ্যাডমিন</button>
  </header>

  <nav class="subnav">
    <button class="nav-btn active" id="tab-feed" onclick="switchTab('feed')">হোম ফিড</button>
    <button class="nav-btn" id="tab-reels" onclick="switchTab('reels')">রিলস ও গান</button>
    <button class="nav-btn" id="tab-places" onclick="switchTab('places')">দর্শনীয় স্থান</button>
    <button class="nav-btn" id="tab-inbox" onclick="switchTab('inbox')">ইনবক্স</button>
    <button class="nav-btn" id="tab-profile" onclick="switchTab('profile')">প্রোফাইল ও বিজ্ঞাপন</button>
    <button class="nav-btn" id="tab-admin" onclick="switchTab('admin')">অ্যাডমিন প্যানেল</button>
  </nav>

  <main class="container">

    <!-- হোম ফিড -->
    <section id="sec-feed">
      <div class="card">
        <div class="card-title">নতুন পোস্ট লিখুন</div>
        <textarea id="postInput" rows="3" placeholder="আজকের খবর, আড্ডা বা এলাকার কোনো কথা লিখুন..."></textarea>
        <select id="postLocationSelect"></select>
        <button class="btn" onclick="addPost()">পোস্ট প্রকাশ করুন</button>
      </div>

      <div class="card">
        <div class="row">
          <strong style="font-size:13px;">লোকেশন দিয়ে ফিল্টার:</strong>
          <select id="feedFilterSelect" style="margin-bottom:0; max-width:240px;" onchange="renderFeed()">
            <option value="সব">সব স্থান</option>
          </select>
        </div>
      </div>

      <div id="feedList"></div>
    </section>

    <!-- রিলস ও সিলেটি গান -->
    <section id="sec-reels" class="hidden">
      <div class="card">
        <div class="card-title">সিলেটি গানে নতুন রিল তৈরি করুন</div>
        <input id="reelTitleInput" type="text" placeholder="রিলের শিরোনাম লিখুন (যেমন: বিকেলে চৈত্রঘাট ব্রিজ)" />
        <select id="reelSongSelect"></select>
        <select id="reelPlaceSelect"></select>
        <button class="btn" onclick="addReel()">রিল যোগ করুন</button>
      </div>

      <div class="card">
        <div class="card-title">সিলেটি গানের তালিকা</div>
        <div id="songList"></div>
      </div>

      <div id="reelsList"></div>
    </section>

    <!-- দর্শনীয় স্থান -->
    <section id="sec-places" class="hidden">
      <div class="card">
        <div class="card-title">কমলগঞ্জ, শ্রীমঙ্গল ও সিলেটের দর্শনীয় স্থান</div>
        <div id="placesList"></div>
      </div>

      <div class="card">
        <div class="card-title">নতুন লোকেশন সাজেস্ট করুন</div>
        <input id="suggestName" type="text" placeholder="জায়গার নাম (যেমন: স্থানীয় দিঘি বা ব্রিজ)" />
        <input id="suggestArea" type="text" placeholder="এলাকা ও উপজেলা (যেমন: প্রতাপী, কমলগঞ্জ)" />
        <button class="btn" onclick="suggestPlace()">সাজেশন পাঠান</button>
      </div>
    </section>

    <!-- ইনবক্স -->
    <section id="sec-inbox" class="hidden">
      <div class="card">
        <div class="card-title">ইনবক্স বার্তা</div>
        <div id="inboxList"></div>
        <div class="row" style="margin-top:10px;">
          <input id="inboxInput" type="text" style="margin-bottom:0; flex:1;" placeholder="মেসেজ লিখুন..." />
          <button class="btn" onclick="sendMessage()">পাঠান</button>
        </div>
      </div>
    </section>

    <!-- প্রোফাইল ও বিজ্ঞাপন -->
    <section id="sec-profile" class="hidden">
      <div class="card">
        <div class="card-title">পারভেজ মিয়া</div>
        <p style="font-size:14px; color:#3c4d41; margin-bottom:8px;">চৈত্রঘাট, কমলগঞ্জ, মৌলভীবাজার • Sylhet Social</p>
        <span class="tag">সুপার অ্যাডমিন</span>
      </div>

      <div class="card">
        <div class="card-title">বিজ্ঞাপন বা প্রমোশন দিন</div>
        <div class="payment-box">
          <div style="font-size:13px; font-weight:700; margin-bottom:6px;">পেমেন্ট নম্বর (বিকাশ / নগদ / রকেট):</div>
          <div class="row">
            <strong id="displayPaymentNumber" style="font-size:16px; color:#0f5132;">01774030406</strong>
            <button class="btn small secondary" onclick="copyPaymentNumber()">নম্বর কপি করুন</button>
          </div>
          <div id="bankInfoText" style="font-size:12px; color:#3c4d41; margin-top:6px;">ব্যাংক: অ্যাডমিন প্যানেল থেকে ব্যাংক তথ্য সেট করুন</div>
        </div>

        <input id="adTitle" type="text" placeholder="বিজ্ঞাপন বা ব্যবসার শিরোনাম" />
        <textarea id="adText" rows="2" placeholder="বিজ্ঞাপনের বিস্তারিত লেখা..."></textarea>
        <select id="adMethod">
          <option value="বিকাশ">বিকাশ</option>
          <option value="নগদ">নগদ</option>
          <option value="রকেট">রকেট</option>
          <option value="ব্যাংক">ব্যাংক</option>
        </select>
        <input id="adTrxId" type="text" placeholder="TrxID বা রেফারেন্স নম্বর দিন" />
        <button class="btn" onclick="submitAdRequest()">বিজ্ঞাপন রিকোয়েস্ট পাঠান</button>
      </div>
    </section>

    <!-- অ্যাডমিন প্যানেল -->
    <section id="sec-admin" class="hidden">
      <div id="adminLockedBox" class="card hidden">
        <div class="card-title">অ্যাডমিন প্যানেল সীমিত</div>
        <p style="font-size:14px; color:#526357;">এই অংশটি দেখতে ও পরিচালনা করতে উপরের মোড থেকে <strong>সুপার অ্যাডমিন</strong> বা <strong>সহকারী অ্যাডমিন</strong> নির্বাচন করুন।</p>
      </div>

      <div id="adminContentBox">
        <div class="card">
          <div class="card-title">বিজ্ঞাপন অনুমোদন তালিকা</div>
          <div id="adminAdsList"></div>
        </div>

        <div id="superAdminOnlySection">
          <div class="card">
            <div class="card-title">পেমেন্ট নম্বর ও ব্যাংক তথ্য সেটিংস</div>
            <input id="adminPhoneInput" type="text" value="01774030406" placeholder="বিকাশ/নগদ/রকেট নম্বর" />
            <input id="adminBankInput" type="text" placeholder="ব্যাংক অ্যাকাউন্টের তথ্য লিখুন" />
            <button class="btn" onclick="savePaymentSettings()">পেমেন্ট তথ্য সংরক্ষণ করুন</button>
          </div>

          <div class="card">
            <div class="card-title">নতুন দর্শনীয় স্থান যোগ করুন</div>
            <input id="newPlaceName" type="text" placeholder="নতুন স্থানের নাম" />
            <input id="newPlaceCat" type="text" placeholder="ধরন (যেমন: ব্রিজ, দিঘি, চা বাগান, দর্শনীয় স্থান)" />
            <button class="btn" onclick="addPlaceDirectly()">স্থানে যুক্ত করুন</button>
          </div>

          <div class="card">
            <div class="card-title">নতুন সিলেটি গান যোগ করুন</div>
            <input id="newSongTitle" type="text" placeholder="গানের নাম ও শিল্পী" />
            <button class="btn" onclick="addSongDirectly()">গান যুক্ত করুন</button>
          </div>

          <div class="card">
            <div class="card-title">সহকারী অ্যাডমিন নিয়োগ</div>
            <input id="coAdminName" type="text" placeholder="সহকারী অ্যাডমিনের নাম" />
            <button class="btn" onclick="addCoAdmin()">সহকারী অ্যাডমিন যুক্ত করুন</button>
            <div id="coAdminList" style="margin-top:10px;"></div>
          </div>
        </div>

        <div class="card">
          <div class="card-title">ইউজারদের প্রস্তাবিত লোকেশন</div>
          <div id="suggestedPlacesList"></div>
        </div>
      </div>
    </section>

  </main>

  <script>
    const state = {
      role: 'super',
      paymentNumber: '01774030406',
      bankInfo: 'ব্যাংক: অ্যাডমিন প্যানেল থেকে ব্যাংক তথ্য সেট করুন',
      places: [
        { name: 'চৈত্রঘাট ব্রিজ', cat: 'ব্রিজ ও নদী' },
        { name: 'ছয় সিঁড়ির দিঘি', cat: 'দিঘি ও ঐতিহ্য' },
        { name: 'কমলগঞ্জ চা বাগান', cat: 'চা বাগান' },
        { name: 'লাওয়াছড়া জাতীয় উদ্যান', cat: 'দর্শনীয় স্থান' },
        { name: 'শ্রীমঙ্গল টি রিসোর্ট এলাকা', cat: 'দর্শনীয় স্থান' },
        { name: 'মাধবপুর লেক', cat: 'দর্শনীয় স্থান' }
      ],
      suggestedPlaces: [],
      songs: [
        'ভ্রমর কইয়ো গিয়া — রাধারমণ',
        'সিলেটের মাটি — লোকগান সংগ্রহ',
        'চা বাগানের সকাল — আঞ্চলিক সুর'
      ],
      coAdmins: ['স্থানীয় মডারেটর'],
      posts: [
        {
          id: 1,
          author: 'পারভেজ মিয়া',
          place: 'চৈত্রঘাট ব্রিজ',
          text: 'বিকেলে চৈত্রঘাট ব্রিজের বাতাস আর আশপাশের দৃশ্য দারুণ লাগে।',
          likes: 5,
          isAd: false,
          comments: ['একদম ঠিক বলেছেন!']
        }
      ],
      reels: [
        {
          id: 1,
          title: 'কমলগঞ্জের সবুজ সকাল',
          song: 'ভ্রমর কইয়ো গিয়া — রাধারমণ',
          place: 'কমলগঞ্জ চা বাগান',
          likes: 8
        }
      ],
      messages: [
        { sender: 'বন্ধু', text: 'ভাই, Sylhet Social-এর কাজ কেমন চলছে?' },
        { sender: 'পারভেজ মিয়া', text: 'হ্যাঁ, ধাপে ধাপে মূল ফিচারগুলো গুছিয়ে নিচ্ছি।' }
      ],
      ads: [
        {
          id: 1,
          title: 'চৈত্রঘাট লোকাল স্টোর',
          text: 'তাজা খাবার ও নিত্যপ্রয়োজনীয় পণ্যের বিশেষ অফার চলছে।',
          method: 'বিকাশ',
          trxId: 'TRX884120',
          status: 'অনুমোদিত'
        }
      ]
    };

    const roleOrder = ['super', 'assistant', 'user'];
    const roleLabels = {
      super: 'মোড: সুপার অ্যাডমিন',
      assistant: 'মোড: সহকারী অ্যাডমিন',
      user: 'মোড: সাধারণ ইউজার'
    };

    function cycleRole() {
      const nextIndex = (roleOrder.indexOf(state.role) + 1) % roleOrder.length;
      state.role = roleOrder[nextIndex];
      document.getElementById('roleToggleBtn').innerText = roleLabels[state.role];
      renderAdmin();
    }

    function switchTab(tabName) {
      const tabs = ['feed', 'reels', 'places', 'inbox', 'profile', 'admin'];
      tabs.forEach(t => {
        document.getElementById('sec-' + t).classList.toggle('hidden', t !== tabName);
        document.getElementById('tab-' + t).classList.toggle('active', t === tabName);
      });
      renderAll();
    }

    function populateLocationSelects() {
      const postSel = document.getElementById('postLocationSelect');
      const reelSel = document.getElementById('reelPlaceSelect');
      const filterSel = document.getElementById('feedFilterSelect');

      const prevFilter = filterSel.value || 'সব';
      postSel.innerHTML = '';
      reelSel.innerHTML = '';
      filterSel.innerHTML = '<option value="সব">সব স্থান</option>';

      state.places.forEach(p => {
        const opt1 = document.createElement('option');
        opt1.value = p.name;
        opt1.textContent = p.name + ' (' + p.cat + ')';
        postSel.appendChild(opt1);

        const opt2 = document.createElement('option');
        opt2.value = p.name;
        opt2.textContent = p.name;
        reelSel.appendChild(opt2);

        const opt3 = document.createElement('option');
        opt3.value = p.name;
        opt3.textContent = p.name;
        filterSel.appendChild(opt3);
      });
      filterSel.value = prevFilter;
    }

    function addPost() {
      const input = document.getElementById('postInput');
      const place = document.getElementById('postLocationSelect').value;
      const text = input.value.trim();
      if (!text) return;
      state.posts.unshift({
        id: Date.now(),
        author: 'পারভেজ মিয়া',
        place,
        text,
        likes: 0,
        isAd: false,
        comments: []
      });
      input.value = '';
      renderFeed();
    }

    function likePost(id) {
      const post = state.posts.find(p => p.id === id);
      if (post) {
        post.likes += 1;
        renderFeed();
      }
    }

    function addComment(id) {
      const el = document.getElementById('comment-input-' + id);
      const val = el ? el.value.trim() : '';
      if (!val) return;
      const post = state.posts.find(p => p.id === id);
      if (post) {
        post.comments.push(val);
        renderFeed();
      }
    }

    function renderFeed() {
      const filter = document.getElementById('feedFilterSelect').value;
      const feedList = document.getElementById('feedList');
      feedList.innerHTML = '';

      const approvedAds = state.ads.filter(a => a.status === 'অনুমোদিত');
      approvedAds.forEach(ad => {
        const adCard = document.createElement('div');
        adCard.className = 'card';
        adCard.innerHTML = `
          <span class="ad-tag">স্পনসর্ড বিজ্ঞাপন</span>
          <div class="card-title" style="margin-bottom:4px;">${ad.title}</div>
          <p class="post-text">${ad.text}</p>
        `;
        feedList.appendChild(adCard);
      });

      const items = state.posts.filter(p => filter === 'সব' || p.place === filter);
      items.forEach(p => {
        const commentsHtml = p.comments.map(c => `<div class="comment-box">${c}</div>`).join('');
        const card = document.createElement('div');
        card.className = 'card';
        card.innerHTML = `
          <div class="post-meta"><strong>${p.author}</strong> • ${p.place}</div>
          <span class="tag">${p.place}</span>
          <p class="post-text">${p.text}</p>
          <div class="row" style="margin-bottom:8px;">
            <button class="btn small secondary" onclick="likePost(${p.id})">পছন্দ (${p.likes})</button>
          </div>
          ${commentsHtml}
          <div class="row" style="margin-top:8px;">
            <input id="comment-input-${p.id}" type="text" style="margin-bottom:0; flex:1;" placeholder="কমেন্ট লিখুন..." />
            <button class="btn small" onclick="addComment(${p.id})">দিন</button>
          </div>
        `;
        feedList.appendChild(card);
      });
    }

    function populateSongSelect() {
      const sel = document.getElementById('reelSongSelect');
      const list = document.getElementById('songList');
      sel.innerHTML = '';
      list.innerHTML = '';
      state.songs.forEach(song => {
        const opt = document.createElement('option');
        opt.value = song;
        opt.textContent = song;
        sel.appendChild(opt);

        const item = document.createElement('div');
        item.className = 'comment-box';
        item.textContent = song;
        list.appendChild(item);
      });
    }

    function addReel() {
      const titleInput = document.getElementById('reelTitleInput');
      const title = titleInput.value.trim();
      const song = document.getElementById('reelSongSelect').value;
      const place = document.getElementById('reelPlaceSelect').value;
      if (!title) return;
      state.reels.unshift({ id: Date.now(), title, song, place, likes: 0 });
      titleInput.value = '';
      renderReels();
    }

    function likeReel(id) {
      const reel = state.reels.find(r => r.id === id);
      if (reel) {
        reel.likes += 1;
        renderReels();
      }
    }

    function renderReels() {
      const box = document.getElementById('reelsList');
      box.innerHTML = '';
      state.reels.forEach(r => {
        const card = document.createElement('div');
        card.className = 'card';
        card.innerHTML = `
          <span class="tag">গান: ${r.song}</span>
          <div class="card-title" style="margin-bottom:4px;">${r.title}</div>
          <div class="post-meta">স্থান: ${r.place}</div>
          <button class="btn small secondary" onclick="likeReel(${r.id})">পছন্দ (${r.likes})</button>
        `;
        box.appendChild(card);
      });
    }

    function renderPlaces() {
      const list = document.getElementById('placesList');
      list.innerHTML = '';
      state.places.forEach(p => {
        const div = document.createElement('div');
        div.className = 'comment-box';
        div.innerHTML = `<strong>${p.name}</strong> — ${p.cat}`;
        list.appendChild(div);
      });
    }

    function suggestPlace() {
      const nameEl = document.getElementById('suggestName');
      const areaEl = document.getElementById('suggestArea');
      const name = nameEl.value.trim();
      const area = areaEl.value.trim() || 'সিলেট';
      if (!name) return;
      state.suggestedPlaces.push({ name, area });
      nameEl.value = '';
      areaEl.value = '';
      alert('আপনার লোকেশন সাজেশন অ্যাডমিন প্যানেলে পাঠানো হয়েছে।');
      renderAdmin();
    }

    function renderInbox() {
      const box = document.getElementById('inboxList');
      box.innerHTML = '';
      state.messages.forEach(m => {
        const div = document.createElement('div');
        div.className = 'msg-bubble' + (m.sender === 'পারভেজ মিয়া' ? ' me' : '');
        div.innerHTML = `<strong>${m.sender}:</strong> ${m.text}`;
        box.appendChild(div);
      });
    }

